# 資料與輸出（大檔案、產物）
data/*
!data/.gitkeep
outputs/*
!outputs/.gitkeep
# runs 內全部檔案都進版控
!outputs/runs/
!outputs/runs/*/
!outputs/runs/*/*
# robustness 總結圖（日誌引用）
!outputs/robustness/
!outputs/robustness/*.png

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# 虛擬環境
.venv/
venv/
env/

# 環境與機密
.env
.env.local
*.pem

# IDE / 編輯器
.idea/
.vscode/
*.swp
*.swo

# 作業系統
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# 模型 checkpoint（若不想進版控可取消註解）
# outputs/*.pt
# outputs/*.pth
